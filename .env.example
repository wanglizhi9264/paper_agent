# Copy to .env and fill in. Never commit .env.
# All variables use the PAPER_RAG_ prefix (see docs/spec.md §18).

PAPER_RAG_ENV=development
PAPER_RAG_LOG_LEVEL=INFO

# --- Infrastructure ---
PAPER_RAG_DATABASE_URL=postgresql+asyncpg://paper_rag:paper_rag_dev@127.0.0.1:5432/paper_rag
PAPER_RAG_REDIS_URL=redis://127.0.0.1:6379/0

# --- Storage ---
PAPER_RAG_STORAGE_DIR=./storage
PAPER_RAG_MAX_UPLOAD_BYTES=104857600

# --- Embedding ---
PAPER_RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Revision must be pinned after first model prepare; leave empty only until Phase 5.
PAPER_RAG_EMBEDDING_REVISION=
PAPER_RAG_EMBEDDING_DEVICE=cuda:0
PAPER_RAG_EMBEDDING_BATCH_SIZE=16
PAPER_RAG_EMBEDDING_DTYPE=float16

# --- Reranker ---
PAPER_RAG_RERANK_MODEL=BAAI/bge-reranker-base
PAPER_RAG_RERANK_REVISION=
PAPER_RAG_RERANK_DEVICE=cuda:0
PAPER_RAG_RERANK_BATCH_SIZE=4
PAPER_RAG_RERANK_DTYPE=float16

# --- Generator (OpenAI-compatible) ---
PAPER_RAG_LLM_BASE_URL=http://127.0.0.1:11434/v1
PAPER_RAG_LLM_MODEL=qwen3:4b-instruct
PAPER_RAG_LLM_API_KEY=paper-rag-local
PAPER_RAG_LLM_CONTEXT_TOKENS=8192

# --- GPU ---
PAPER_RAG_CUDA_DEVICE=cuda:0
PAPER_RAG_GPU_MAX_CONCURRENCY=1

# --- PDF Ingestion V2 (docs/pdf-ingestion-v2-spec.md §14) ---
PAPER_RAG_PDF_IR_SCHEMA_VERSION=2
PAPER_RAG_PDF_PARSER=auto
PAPER_RAG_PDF_LAYOUT_PARSER=docling
PAPER_RAG_PDF_NORMALIZER_VERSION=unicode-v2
PAPER_RAG_PDF_FAST_PATH_MIN_READING_ORDER_CONFIDENCE=0.95
PAPER_RAG_PDF_MAX_ORPHAN_NUMERIC_RATIO=0.05
PAPER_RAG_PDF_MAX_REPLACEMENT_CHARACTERS=0

# --- Docling (requires: uv sync --extra pdf-layout) ---
PAPER_RAG_DOCLING_OCR=false
PAPER_RAG_DOCLING_TABLE_STRUCTURE=true
PAPER_RAG_DOCLING_FORMULA_ENRICHMENT=true
PAPER_RAG_DOCLING_DEVICE=cpu
# Model ids/revisions feed the parser signature (spec §6.2). Revisions are
# resolved by `uv run python -m app.cli.docling_setup` and must be pinned
# before production use.
PAPER_RAG_DOCLING_LAYOUT_MODEL=docling-project/docling-layout-heron
PAPER_RAG_DOCLING_TABLE_MODEL=docling-project/TableFormer
PAPER_RAG_DOCLING_LAYOUT_REVISION=
PAPER_RAG_DOCLING_TABLE_REVISION=
# Optional local model artifacts directory for offline runs (docling-tools).
PAPER_RAG_DOCLING_ARTIFACTS_PATH=

# --- Server ---
PAPER_RAG_HOST=127.0.0.1
PAPER_RAG_PORT=8000
PAPER_RAG_CORS_ALLOW_ORIGINS=["http://127.0.0.1:5173"]
